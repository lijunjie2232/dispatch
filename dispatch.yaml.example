# 示例配置文件
# 将此文件复制为 dispatch.yaml 并根据需要修改

# 服务器监听的IP地址（可选，默认为127.0.0.1）
ip: "127.0.0.1"

# 服务器监听的端口（可选，默认为1080）
port: 1080

# addresses 参数定义了要使用的网络接口IP地址及其优先级
# 格式为 <IP地址>[/优先级]
# 如果未指定优先级，则默认为 1
# 优先级越高，被选中的概率越大

addresses:
  - "192.168.1.100/3"  # 高优先级
  - "192.168.1.101"    # 默认优先级 (1)
  - "10.0.0.1/2"       # 中等优先级
